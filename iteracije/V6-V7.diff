 // Seeding: sve k-mere reada -> pozicije u indeksu -> glasanje po dijagonali (p - offset).
@@ -290,26 +293,35 @@ inline MapResult mapRead(EncodedView read, EncodedView rc, const KmerIndex& idx,
                          const MapParams& p, Stats& st) {
